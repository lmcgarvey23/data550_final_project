# Load packages
library(dplyr)
library(ggplot2)
# Load the data
heart <- read.csv("https://archive.ics.uci.edu/ml/machine-learning-databases/heart-disease/processed.cleveland.data",
header = FALSE)
# Add variable names
names(heart) <- c(
"age", "sex", "cp", "trestbps", "chol", "fbs",
"restecg", "thalach", "exang", "oldpeak",
"slope", "ca", "thal", "num"
)
# Look at the data
head(heart)
View(heart)
# Load packages
library(dplyr)
library(ggplot2)
# Load the data
heart <- read.csv("https://archive.ics.uci.edu/ml/machine-learning-databases/heart-disease/processed.cleveland.data",
header = FALSE)
# Add variable names
names(heart) <- c(
"age", "sex", "cp", "trestbps", "chol", "fbs",
"restecg", "thalach", "exang", "oldpeak",
"slope", "ca", "thal", "num"
)
# Look at the data
head(heart)
heart <- heart %>%
mutate(
heart_disease = ifelse(num > 0, "Heart disease", "No heart disease")
)
table1 <- heart %>%
group_by(heart_disease) %>%
summarise(
Number of patients = n(),
table1 <- heart %>%
group_by(heart_disease) %>%
summarise(
N = n(),
Mean_age = round(mean(age, na.rm = TRUE), 1),
Mean_cholesterol = round(mean(chol, na.rm = TRUE), 1),
Mean_blood_pressure = round(mean(trestbps, na.rm = TRUE), 1),
Mean_max_heart_rate = round(mean(thalach, na.rm = TRUE), 1)
)
table1
ggplot(heart, aes(x = heart_disease, y = age)) +
geom_boxplot() +
labs(
title = "Age by Heart Disease Status",
x = "Heart Disease Status",
y = "Age (years)"
)
